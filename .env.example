# Required
TELEGRAM_CODEX_BOT_TOKEN=123456:your_bot_token_here
TCB_ALLOWED_USER_IDS=123456789

# Codex CLI settings
# Leave TCB_CODEX_MODEL empty to use the Codex CLI default model.
TCB_CODEX_MODEL=
TCB_WORKING_DIR=.\workspace
TCB_CODEX_EXTRA_DIRS=
TCB_CODEX_TIMEOUT=1800
TCB_CODEX_SEARCH=false

# Safety switch:
# false = do not pass --full-auto to Codex CLI.
# true  = pass --full-auto for unattended local edits/commands. Use with care.
TCB_CODEX_FULL_AUTO=false
TCB_CODEX_SKIP_GIT_REPO_CHECK=true

# Runtime paths
TCB_LOG_DIR=.\logs
TCB_RUN_DIR=.\runs
TCB_FETCH_OUTPUT_DIR=.\fetch_outputs
TCB_OBSIDIAN_MOBILE_DIR=.\obsidian_clippings
TCB_STATS_FILE=.\stats.json

# Telegram output behavior
TCB_PROGRESS_EDIT_INTERVAL=2.0
TCB_OUTPUT_MAX_CHARS=12000

# URL preprocessing
TCB_URL_FETCH_TIMEOUT=20
TCB_FETCH_MAX_RETRIES=2
TCB_GITHUB_README_MAX_LEN=8000
TCB_THIN_CONTENT_THRESHOLD=200

# Optional API keys used by URL/Vision helper modules
# GITHUB_TOKEN=ghp_your_token_here
# GOOGLE_API_KEY=your_google_api_key_here
# TCB_IMAGE_ANALYSIS_ENABLED=false
# TCB_IMAGE_ANALYSIS_TIMEOUT=30
